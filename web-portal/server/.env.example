# Copy to .env and adjust if your setup differs from the defaults baked
# into server.js. All of these already match the tomorrow-auth docker-compose
# setup out of the box, so .env is optional for local development.

PORT=3010
APP_BASE_URL=http://localhost:3010
KEYCLOAK_ISSUER=http://localhost:8081/realms/tomorrow
CLIENT_ID=web-portal
SESSION_SECRET=change-me-to-a-random-string
