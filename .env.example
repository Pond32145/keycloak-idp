# Copy this file to .env and change every password before starting the stack.
# .env is gitignored — never commit real credentials.

# ---- PostgreSQL (Keycloak's database) ----
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change-me-strong-password

# ---- Keycloak bootstrap admin account ----
# Only takes effect on the very first boot, when no admin user exists yet in
# the "master" realm. Changing these afterwards has no effect until the
# database is reset.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password

# ---- Keycloak networking ----
# Port exposed on localhost for the Keycloak HTTP listener.
KEYCLOAK_PORT=8080
# Hostname Keycloak reports in issued tokens/URLs for local development.
KC_HOSTNAME=localhost
